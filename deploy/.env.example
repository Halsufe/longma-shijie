# 龙马·视界 生产环境配置示例
# 复制为 .env 并填写真实值后：docker compose --env-file .env up -d

ENV=prod
APP_NAME=龙马视界
APP_VERSION=0.1.0

# 必改：使用强随机串（openssl rand -hex 32）
SECRET_KEY=please-generate-a-strong-secret-key

# Access Token 30 分钟，Refresh Token 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL 连接（compose 会注入，本地直连填这个）
DB_URL=postgresql+psycopg2://longma:change-me@db:5432/longma

STORAGE_PATH=/app/backend/storage

# AI 模型（必填，生产校验）
# 当前项目使用 DeepSeek，如需切换其他 OpenAI 兼容服务商请改此处
AI_API_KEY=sk-xxxxxxxxxxxxxxxx
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro

# CORS：生产必须指定具体域名，不可为 *
CORS_ORIGINS=https://longma.example.com

CLASS_NAME=大数据管理与应用25级
DEFAULT_QUOTA_MB=500

# 限流
API_RATE_LIMIT=120
API_RATE_WINDOW_MINUTES=1

# 文件软删保留期（天）
FILE_RETENTION_DAYS=7

# MCP 工具接口服务令牌（必改）
MCP_SERVICE_TOKEN=please-generate-a-strong-mcp-token
MCP_FETCH_TIMEOUT=10

# PostgreSQL 容器初始化
POSTGRES_DB=longma
POSTGRES_USER=longma
POSTGRES_PASSWORD=change-me
