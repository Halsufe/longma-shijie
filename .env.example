APP_NAME=龙马视界
APP_VERSION=0.1.0
ENV=dev

# JWT 签名密钥（必填，用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=your-generated-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库（开发用 SQLite，存放在 database/ 目录）
DB_URL=sqlite:///./database/longma.db
STORAGE_PATH=./backend/storage
# 生产环境改为 supabase，并填写 Supabase Storage 管理密钥（只放在 Render 环境变量）
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=longma-files
ACHIEVEMENT_FILE_MAX_MB=20
PARTY_MATERIAL_MAX_MB=20
PARTY_CLASSES=大数据25级,大数据24级,大数据23级,大数据22级
PARTY_SIGN_IN_WINDOW_MINUTES=60

# AI 服务（接入外部 AI 平台，已配置为 DeepSeek）
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
WEB_SEARCH_ENABLED=true
WEB_SEARCH_URL=https://www.bing.com/search
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_RESULTS=5

# 业务 Skill 语义向量（模型名也可替换为本地离线路径）
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=32
SKILL_RECOMMEND_LIMIT=5
SEMANTIC_MIN_SCORE=0.35

# CORS（开发环境允许所有来源；生产环境必须指定具体域名）
CORS_ORIGINS=*

CLASS_NAME=大数据管理与应用25级
DEFAULT_QUOTA_MB=500

LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=5

# MCP 服务令牌（必填，用 python -c "import secrets; print('lm_mcp_'+secrets.token_hex(24))" 生成）
MCP_SERVICE_TOKEN=lm_mcp_your-generated-mcp-token-here
MCP_FETCH_TIMEOUT=10

# API 限流（滑动窗口，每分钟最大请求数）
API_RATE_LIMIT=120
API_RATE_WINDOW_MINUTES=1

# 文件软删除保留天数（超期物理删除）
FILE_RETENTION_DAYS=7

# 文件在线预览（Office 转换依赖系统安装 LibreOffice/soffice）
PREVIEW_OFFICE_ENABLED=true
PREVIEW_OFFICE_TIMEOUT_SECONDS=60
PREVIEW_OFFICE_MAX_MB=20
PREVIEW_OFFICE_CONCURRENCY=2
PREVIEW_CACHE_TTL_DAYS=7
